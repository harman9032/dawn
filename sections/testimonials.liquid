{{ 'section-testimonials.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign show_mobile_slider = false
  if section.settings.swipe_on_mobile and section.blocks.size > 1
    assign show_mobile_slider = true
  endif
-%}

<div class="testimonials color-{{ section.settings.color_scheme }} gradient{% if show_mobile_slider %} testimonials--mobile-slider{% endif %}">
  <div
    class="page-width section-{{ section.id }}-padding isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    {% if settings.animations_reveal_on_scroll %}
      data-cascade
    {% endif %}
  >
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="testimonials__header center">
        {%- if section.settings.heading != blank -%}
          <h2 class="testimonials__heading inline-richtext {{ section.settings.heading_size }}">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
        {% render 'ornament-divider', align: 'center' %}
        {%- if section.settings.subheading != blank -%}
          <p class="testimonials__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <slider-component class="slider-mobile-gutter">
      <ul
        class="testimonials__list contains-content-container grid grid--2-col-tablet grid--3-col-desktop{% if show_mobile_slider %} slider slider--mobile grid--peek{% endif %}"
        id="Slider-{{ section.id }}"
        role="list"
      >
        {%- for block in section.blocks -%}
          {%- liquid
            assign rating = block.settings.rating | default: 5
          -%}
          <li
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="testimonials__item grid__item{% if show_mobile_slider %} slider__slide{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {{ block.shopify_attributes }}
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
            <div class="testimonials__card content-container">
              <div
                class="testimonials__rating"
                role="img"
                aria-label="{{ rating }} out of 5 stars"
              >
                {%- for i in (1..5) -%}
                  <span class="testimonials__star{% if i <= rating %} testimonials__star--filled{% endif %}" aria-hidden="true">
                    {{- 'icon-star.svg' | inline_asset_content -}}
                  </span>
                {%- endfor -%}
              </div>

              {%- if block.settings.quote != blank -%}
                <blockquote class="testimonials__quote rte">
                  {{ block.settings.quote }}
                </blockquote>
              {%- endif -%}

              {%- if block.settings.author != blank or block.settings.detail != blank or block.settings.image != blank -%}
                <div class="testimonials__author">
                  {%- if block.settings.image != blank -%}
                    <div class="testimonials__avatar">
                      {{
                        block.settings.image
                        | image_url: width: 120
                        | image_tag:
                          loading: 'lazy',
                          width: 120,
                          height: 120,
                          class: 'testimonials__avatar-image',
                          alt: block.settings.author
                      }}
                    </div>
                  {%- endif -%}
                  <div class="testimonials__meta">
                    {%- if block.settings.author != blank -%}
                      <p class="testimonials__name">{{ block.settings.author | escape }}</p>
                    {%- endif -%}
                    {%- if block.settings.detail != blank -%}
                      <p class="testimonials__detail">{{ block.settings.detail | escape }}</p>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>

      {%- if show_mobile_slider -%}
        <div class="slider-buttons large-up-hide">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
          >
            <span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span>
          </button>
          <div class="slider-counter caption">
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
            <span class="slider-counter--total">{{ section.blocks.size }}</span>
          </div>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'general.slider.next_slide' | t }}"
          >
            <span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span>
          </button>
        </div>
      {%- endif -%}
    </slider-component>
  </div>
</div>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 12,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "What collectors say",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "info": "Optional short line under the heading."
    },
    {
      "type": "checkbox",
      "id": "swipe_on_mobile",
      "default": true,
      "label": "Enable swipe on mobile"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5,
          "label": "Star rating"
        },
        {
          "type": "richtext",
          "id": "quote",
          "default": "<p>The detail in this piece is unreal. It hangs above our sofa and every guest stops to look at it.</p>",
          "label": "Quote"
        },
        {
          "type": "text",
          "id": "author",
          "default": "Happy collector",
          "label": "Author name"
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Detail",
          "info": "For example: Bought: Lotus Bloom 24×24"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo",
          "info": "Optional round avatar. A square image works best."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "quote": "<p>I framed it the day it arrived and it completely changed our living room. The linework is so fine you keep finding new patterns inside patterns.</p>",
            "author": "Priya S.",
            "detail": "Bought: Lotus Bloom 24×24"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "quote": "<p>Arrived beautifully packed, flat and protected, with a handwritten note. You can tell every stroke was done by hand, not printed.</p>",
            "author": "Daniel M.",
            "detail": "Bought: Indigo Sun original"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "quote": "<p>Ordered one as a housewarming gift and my sister cried. Calm, warm, and it goes with everything in her flat. I have since bought two more for myself.</p>",
            "author": "Amara K.",
            "detail": "Bought: Terracotta Dawn print"
          }
        }
      ]
    }
  ]
}
{% endschema %}
