{{ 'section-instagram-gallery.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign columns_desktop = section.settings.columns_desktop
  assign columns_mobile = section.settings.columns_mobile | plus: 0
-%}

<div class="instagram-gallery color-{{ section.settings.color_scheme }} gradient">
  <div
    class="page-width section-{{ section.id }}-padding isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    {% if settings.animations_reveal_on_scroll %}
      data-cascade
    {% endif %}
  >
    {%- if section.settings.heading != blank or section.settings.handle != blank -%}
      <div class="instagram-gallery__header center">
        {%- if section.settings.heading != blank -%}
          <h2 class="instagram-gallery__heading inline-richtext {{ section.settings.heading_size }}">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
        {%- if section.settings.handle != blank -%}
          <a
            class="link underlined-link instagram-gallery__handle"
            {% if section.settings.handle_link == blank %}
              role="link" aria-disabled="true"
            {% else %}
              href="{{ section.settings.handle_link }}" target="_blank" rel="noopener"
            {% endif %}
          >
            <span class="svg-wrapper instagram-gallery__handle-icon" aria-hidden="true">
              {{- 'icon-instagram.svg' | inline_asset_content -}}
            </span>
            {{- section.settings.handle | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul
      class="instagram-gallery__grid instagram-gallery__grid--{{ columns_mobile }}-col-mobile instagram-gallery__grid--{{ columns_desktop }}-col-desktop"
      role="list"
    >
      {%- for block in section.blocks -%}
        {%- liquid
          assign item_link = block.settings.link
          if item_link == blank
            assign item_link = section.settings.handle_link
          endif
          assign placeholder_index = forloop.index0 | modulo: 4 | plus: 1
          assign placeholder_image = 'collection-apparel-' | append: placeholder_index
          assign item_alt = block.settings.caption
          if item_alt == blank
            assign item_alt = 'Instagram photo ' | append: forloop.index
          endif
        -%}
        <li
          class="instagram-gallery__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          {{ block.shopify_attributes }}
          {% if settings.animations_reveal_on_scroll %}
            data-cascade
            style="--animation-order: {{ forloop.index }};"
          {% endif %}
        >
          {%- if item_link != blank -%}
            <a
              class="instagram-gallery__link"
              href="{{ item_link }}"
              target="_blank"
              rel="noopener"
              aria-label="{{ item_alt | escape }}"
            >
          {%- else -%}
            <div class="instagram-gallery__link">
          {%- endif -%}
            <div class="instagram-gallery__media">
              {%- if block.settings.image != blank -%}
                {%- capture sizes -%}
                  (min-width: {{ settings.page_width }}px) calc(({{ settings.page_width }}px - 10rem) / {{ columns_desktop }}),
                  (min-width: 990px) calc((100vw - 10rem) / {{ columns_desktop }}),
                  (min-width: 750px) calc((100vw - 10rem) / {{ columns_desktop | at_most: 4 }}),
                  calc((100vw - 3rem) / {{ columns_mobile }})
                {%- endcapture -%}
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    widths: '200, 300, 400, 500, 600, 800, 1000, 1200',
                    sizes: sizes,
                    class: 'instagram-gallery__image',
                    alt: item_alt
                }}
              {%- else -%}
                {{ placeholder_image | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
              <span class="instagram-gallery__overlay" aria-hidden="true">
                <span class="svg-wrapper instagram-gallery__overlay-icon">
                  {{- 'icon-instagram.svg' | inline_asset_content -}}
                </span>
              </span>
            </div>
          {%- if item_link != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Instagram gallery",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 12,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Art in your home",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "text",
      "id": "handle",
      "default": "@yourstudio",
      "label": "Instagram handle"
    },
    {
      "type": "url",
      "id": "handle_link",
      "label": "Instagram profile link",
      "info": "Also used for images that have no link of their own."
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 6,
      "label": "Number of columns on desktop"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        {
          "value": "2",
          "label": "2 columns"
        },
        {
          "value": "3",
          "label": "3 columns"
        }
      ],
      "default": "3",
      "label": "Number of columns on mobile"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Shown as a square. A square image works best."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional. Falls back to the Instagram profile link."
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "info": "Used as the image alt text."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram gallery",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}
