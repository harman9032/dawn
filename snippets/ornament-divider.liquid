{% comment %}
  Renders a small decorative mandala divider (thin rule, 8-petal rosette, end dots).
  Color is inherited from the gold theme variable via component-ornament.css.

  Accepts:
  - align: {String} 'left' or 'center' (optional, default: 'center')

  Usage:
  {% render 'ornament-divider', align: 'center' %}
{% endcomment %}

{{ 'component-ornament.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign ornament_align = align | default: 'center'
-%}

<div class="ornament-divider ornament-divider--{{ ornament_align }}" aria-hidden="true">
  <svg
    class="ornament-divider__svg"
    width="120"
    height="14"
    viewBox="0 0 120 14"
    fill="none"
    stroke="currentColor"
    stroke-width="1"
    stroke-linecap="round"
    xmlns="http://www.w3.org/2000/svg"
  >
    <line x1="6" y1="7" x2="46" y2="7" />
    <line x1="74" y1="7" x2="114" y2="7" />
    <circle cx="2.5" cy="7" r="1.5" fill="currentColor" stroke="none" />
    <circle cx="117.5" cy="7" r="1.5" fill="currentColor" stroke="none" />
    <g transform="translate(60 7)">
      <ellipse cx="0" cy="-4.2" rx="1.3" ry="2.4" />
      <ellipse cx="0" cy="-4.2" rx="1.3" ry="2.4" transform="rotate(45)" />
      <ellipse cx="0" cy="-4.2" rx="1.3" ry="2.4" transform="rotate(90)" />
      <ellipse cx="0" cy="-4.2" rx="1.3" ry="2.4" transform="rotate(135)" />
      <ellipse cx="0" cy="-4.2" rx="1.3" ry="2.4" transform="rotate(180)" />
      <ellipse cx="0" cy="-4.2" rx="1.3" ry="2.4" transform="rotate(225)" />
      <ellipse cx="0" cy="-4.2" rx="1.3" ry="2.4" transform="rotate(270)" />
      <ellipse cx="0" cy="-4.2" rx="1.3" ry="2.4" transform="rotate(315)" />
      <circle cx="0" cy="0" r="2.2" />
      <circle cx="0" cy="0" r="0.9" fill="currentColor" stroke="none" />
    </g>
  </svg>
</div>
