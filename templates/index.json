    "artist": {
      "type": "image-with-text",
      "blocks": {
        "caption": {
          "type": "caption",
          "settings": {
            "caption": "Meet the artist",
            "text_style": "caption-with-letter-spacing",
            "text_size": "medium"
          }
        },
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "Drawn by hand, one ring at a time",
            "heading_size": "h1"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>I started drawing mandalas as a way to slow down. Years later, each piece still begins with a single dot in the centre of the page and grows outward over many quiet hours. Every original that leaves the studio is signed, and every print is made from the hand-drawn original.</p>",
            "text_style": "body"
          }
        },
        "signature": {
          "type": "caption",
          "settings": {
            "caption": "Hand-drawn since 2016",
            "text_style": "signature",
            "text_size": "medium"
          }
        },
