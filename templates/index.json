    "faq": {
      "type": "collapsible-content",
      "blocks": {
        "f1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What sizes are available?",
            "icon": "ruler",
            "row_content": "<p>Most pieces come in three sizes, listed on each product page. Originals are one size only. Custom sizes are available through commissions.</p>"
          }
        },
        "f2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Do prints come framed?",
            "icon": "box",
            "row_content": "<p>Prints ship unframed unless a framed option is selected. All standard sizes fit common off-the-shelf frames.</p>"
          }
        },
        "f3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How long does shipping take?",
            "icon": "truck",
            "row_content": "<p>Orders ship within 2–3 business days. Domestic delivery usually takes 3–5 days; international 7–14 days.</p>"
          }
        },
        "f4": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What if my order arrives damaged?",
            "icon": "return",
            "row_content": "<p>Email us a photo within 7 days and we will replace it free of charge.</p>"
          }
        },
        "f5": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Can I order a custom mandala?",
            "icon": "heart",
            "row_content": "<p>Yes. Share your colours, size and the meaning you want in the piece, and we will send a sketch before drawing begins.</p>"
          }
        },
        "f6": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How are digital downloads delivered?",
            "icon": "lightning_bolt",
            "row_content": "<p>A download link is emailed to you immediately after checkout and is also available in your order confirmation.</p>"
          }
        }
      },
      "block_order": [
        "f1",
        "f2",
        "f3",
        "f4",
        "f5",
        "f6"
      ],
